# SQLite is local-only authority or durable outbox when Notion sync is enabled.
# Keep production data outside iCloud and the repository.
QB_STUDY_DB_PATH="/Users/your-name/Library/Application Support/qb-study-system/qb-study.sqlite"
QB_STUDY_COLLECTOR_PORT=8765
QB_STUDY_TIME_ZONE=Asia/Tokyo
QB_STUDY_LOG_LEVEL=info

# Optional future read-only/reporting destination. No sync is implemented yet.
QB_STUDY_GOOGLE_SPREADSHEET_ID=

# Optional override for the protected Notion JSON configuration file.
# This file is NOT automatically loaded. No token belongs in this example.
# QB_STUDY_NOTION_CONFIG=/absolute/path/notion-sync.json
