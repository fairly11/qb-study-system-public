{
  "$id": "https://schemas.qb-study.local/v1/study-attempt-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "attempt",
    "context"
  ],
  "properties": {
    "attempt": {
      "$id": "https://schemas.qb-study.local/v1/attempt-event-v1.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "record_type",
        "provenance",
        "quality",
        "event_id",
        "question_key",
        "answered_at",
        "result",
        "selected_option_indices"
      ],
      "properties": {
        "schema_version": {
          "const": "1",
          "type": "string"
        },
        "record_type": {
          "const": "attempt_event",
          "type": "string"
        },
        "provenance": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "producer",
            "producer_version",
            "source_system",
            "recorded_at"
          ],
          "properties": {
            "producer": {
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:/+%#=~-]*$",
              "type": "string"
            },
            "producer_version": {
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:/+%#=~-]*$",
              "type": "string"
            },
            "source_system": {
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:/+%#=~-]*$",
              "type": "string"
            },
            "source_record_id": {
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:/+%#=~-]*$",
              "type": "string"
            },
            "recorded_at": {
              "description": "ISO 8601 date-time with an explicit offset whose normalized UTC value has a four-digit year.",
              "format": "date-time",
              "pattern": "^(?:[0-9]{4})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?(?:Z|[+-](?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))$",
              "type": "string"
            }
          }
        },
        "quality": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "acquisition_method",
            "temporal_precision",
            "state_precision"
          ],
          "properties": {
            "acquisition_method": {
              "const": "direct_capture",
              "type": "string"
            },
            "temporal_precision": {
              "const": "exact",
              "type": "string"
            },
            "state_precision": {
              "const": "exact",
              "type": "string"
            }
          }
        },
        "event_id": {
          "format": "uuid",
          "type": "string"
        },
        "question_key": {
          "description": "Canonical Japanese medical national examination question key.",
          "pattern": "^[0-9]{3}[A-Z][1-9][0-9]{0,2}$",
          "type": "string"
        },
        "question_group_id": {
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:/+%#=~-]*$",
          "type": "string"
        },
        "answered_at": {
          "description": "ISO 8601 date-time with an explicit offset whose normalized UTC value has a four-digit year.",
          "format": "date-time",
          "pattern": "^(?:[0-9]{4})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?(?:Z|[+-](?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))$",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "const": "correct",
              "type": "string"
            },
            {
              "const": "incorrect",
              "type": "string"
            },
            {
              "const": "unknown",
              "type": "string"
            }
          ]
        },
        "selected_option_indices": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minimum": 1,
            "maximum": 9007199254740991,
            "type": "integer"
          }
        }
      }
    },
    "context": {
      "$id": "https://schemas.qb-study.local/v1/study-context.schema.json",
      "allOf": [
        {
          "if": {
            "properties": {
              "review_plan_id": {}
            },
            "required": [
              "review_plan_id"
            ]
          },
          "then": {
            "properties": {
              "study_mode": {
                "const": "review"
              }
            }
          }
        }
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "record_type",
        "event_id",
        "study_mode"
      ],
      "properties": {
        "schema_version": {
          "const": "1",
          "type": "string"
        },
        "record_type": {
          "const": "study_context",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "type": "string"
        },
        "study_mode": {
          "anyOf": [
            {
              "const": "normal",
              "type": "string"
            },
            {
              "const": "review",
              "type": "string"
            },
            {
              "const": "unclassified",
              "type": "string"
            }
          ]
        },
        "review_plan_id": {
          "format": "uuid",
          "type": "string"
        }
      }
    }
  }
}
