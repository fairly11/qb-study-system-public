// Override identifiers and your Team in ignored Local.xcconfig before signing.
QB_BUNDLE_PREFIX = org.example.qbstudy
QB_APP_GROUP_ID = group.org.example.qbstudy
DEVELOPMENT_TEAM =
IPHONEOS_DEPLOYMENT_TARGET = 16.4
SWIFT_VERSION = 5.0
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = Config/QBRecord.entitlements
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SDKROOT = iphoneos
CLANG_ENABLE_MODULES = YES
SWIFT_EMIT_LOC_STRINGS = YES
#include? "Local.xcconfig"
